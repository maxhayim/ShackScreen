<?xml version="1.0" encoding="utf-8"?>
<!-- Behind an icon and its name: nothing, or an amber outline when focused, blue while being moved. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <solid android:color="@color/tile" />
            <stroke android:width="2dp" android:color="@color/accent2" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/tile" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
